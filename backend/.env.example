# Django Core Configuration
SECRET_KEY=django-insecure-your-secret-key-goes-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,*

# CORS Configuration
CORS_ALLOW_ALL_ORIGINS=True

# Database Configuration
